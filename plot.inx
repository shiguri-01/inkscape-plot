<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Plot</name>
  <id>org.shiguri.effect.plot</id>
  <dependency type="executable" location="inx">src/main.py</dependency>

  <param name="tab" type="notebook">
    <page name="data" gui-text="Data">
      <param name="data_text" type="string" appearance="multiline" gui-text="Data:" />
      <spacer />
      <param name="data_delim" type="optiongroup" appearance="combo" gui-text="Column delimiter:">
        <option value="tab">tab</option>
        <option value="space">space</option>
        <option value="comma">,</option>
        <option value="semicolon">;</option>
      </param>
      <spacer size="expand" />
      <label>Lines starting with "#" are treated as comments and ignored</label>
    </page>

    <page name="x_axis" gui-text="X Axis">
      <param name="x_scale" type="notebook">
        <page name="x_axis_linear" gui-text="Linear">
          <hbox indent="1">
            <param name="x_axis_linear_min" type="float" precision="6" gui-text="Min:" min="-999999999999999"
              max="999999999999999">0</param>
            <spacer />
            <param name="x_axis_linear_max" type="float" precision="6" gui-text="Max:" min="-999999999999999"
              max="999999999999999">100</param>
          </hbox>
          <spacer />

          <label appearance="header">Tick Lines</label>
          <vbox indent="1">
            <label appearance="header">Major Ticks</label>
            <hbox indent="1">
              <param name="x_linear_maintick_step" type="float" precision="6" gui-text="Step:" min="0"
                max="999999999999999">10</param>
              <spacer />
              <param name="x_linear_maintick_offset" type="float" precision="6" gui-text="Offset:"
                min="-999999"
                max="999999">0</param>
            </hbox>
            <spacer size="4" />
            <label appearance="header">Minor Ticks</label>
            <hbox indent="1">
              <param name="x_linear_subtick_step" type="float" precision="6" gui-text="Step:" min="0"
                max="999999999999999">10</param>
              <spacer />
              <param name="x_linear_subtick_offset" type="float" precision="6" gui-text="Offset:"
                min="-999999999999999"
                max="999999999999999">0</param>
            </hbox>
            <spacer size="4" />
            <param name="x_linear_tick_mirror" type="bool" gui-text="Show on opposite side">false</param>
          </vbox>
          <spacer />

          <label appearance="header">Tick Labels</label>
          <hbox indent="1">
            <param name="x_linear_numtick_step" type="float" precision="6" gui-text="Step:"
              min="0" max="999999999999999">
              10</param>
            <spacer />
            <param name="x_linear_numtick_offset" type="float" precision="6" gui-text="Offset:"
              min="-999999999999999" max="999999999999999">
              0</param>
          </hbox>
          <spacer />
        </page>

        <page name="x_axis_log" gui-text="Logarithmic">
          <hbox indent="1">
            <param name="x_axis_log_min" type="string" gui-text="Min:">0.1</param>
            <spacer />
            <param name="x_axis_log_max" type="string" gui-text="Max:">100</param>
          </hbox>
          <label indent="1">Can be set as 0.001 or 1e-3</label>
          <spacer />

          <label appearance="header">Tick Lines</label>
          <vbox indent="1">
            <param name="x_log_maintick_visible" type="bool" gui-text="Major ticks (1, 10...)">true</param>
            <param name="x_log_subtick_visible" type="bool" gui-text="Minor ticks (2, 3...)">true</param>
            <param name="x_log_tick_mirror" type="bool" gui-text="Draw on opposite side">false</param>
          </vbox>
          <spacer />

          <label appearance="header">Tick Labels</label>
          <hbox indent="1">
            <param name="x_log_numtick_visible" type="bool" gui-text="Show">true</param>
          </hbox>
          <spacer />
        </page>
      </param>
      <spacer />

      <label appearance="header">Label</label>
      <param name="x_axis_label" type="string" gui-text="Text:" indent="1">x</param>
      <spacer />

      <label appearance="header">Placement</label>
      <hbox indent="1">
        <param name="x_axis_placement" type="optiongroup" appearance="combo" gui-text="Position:">
          <option value="bottom">Bottom</option>
          <option value="top">Top</option>
        </param>
        <spacer />
        <param name="x_axis_pos" type="int" gui-text="Outside offset (px):" min="-9999" max="9999">
          0</param>
      </hbox>
    </page>

    <page name="y_axis" gui-text="Y Axis">
      <param name="y_scale" type="notebook">
        <page name="y_axis_linear" gui-text="Linear">
          <hbox indent="1">
            <param name="y_axis_linear_min" type="float" precision="6" gui-text="Min:" min="-999999999999999"
              max="999999999999999">0</param>
            <spacer />
            <param name="y_axis_linear_max" type="float" precision="6" gui-text="Max:" min="-999999999999999"
              max="999999999999999">100</param>
          </hbox>
          <spacer />

          <label appearance="header">Tick Lines</label>
          <vbox indent="1">
            <label appearance="header">Major Ticks</label>
            <hbox indent="1">
              <param name="y_linear_maintick_step" type="float" precision="6" gui-text="Step:" min="0"
                max="999999999999999">10</param>
              <spacer />
              <param name="y_linear_maintick_offset" type="float" precision="6" gui-text="Offset:"
                min="-999999"
                max="999999">0</param>
            </hbox>
            <spacer size="4" />
            <label appearance="header">Minor Ticks</label>
            <hbox indent="1">
              <param name="y_linear_subtick_step" type="float" precision="6" gui-text="Step:" min="0"
                max="999999999999999">10</param>
              <spacer />
              <param name="y_linear_subtick_offset" type="float" precision="6" gui-text="Offset:"
                min="-999999999999999"
                max="999999999999999">0</param>
            </hbox>
            <spacer size="4" />
            <param name="y_linear_tick_mirror" type="bool" gui-text="Show on opposite side">false</param>
          </vbox>
          <spacer />

          <label appearance="header">Tick Labels</label>
          <hbox indent="1">
            <param name="y_linear_numtick_step" type="float" precision="6" gui-text="Step:"
              min="0" max="999999999999999">
              10</param>
            <spacer />
            <param name="y_linear_numtick_offset" type="float" precision="6" gui-text="Offset:"
              min="-999999999999999" max="999999999999999">
              0</param>
          </hbox>
          <spacer />
        </page>

        <page name="y_axis_log" gui-text="Logarithmic">
          <hbox indent="1">
            <param name="y_axis_log_min" type="string" gui-text="Min:">0.1</param>
            <spacer />
            <param name="y_axis_log_max" type="string" gui-text="Max:">100</param>
          </hbox>
          <label indent="1">Can be set as 0.001 or 1e-3</label>
          <spacer />

          <label appearance="header">Tick Lines</label>
          <vbox indent="1">
            <param name="y_log_maintick_visible" type="bool" gui-text="Major ticks (1, 10...)">true</param>
            <param name="y_log_subtick_visible" type="bool" gui-text="Minor ticks (2, 3...)">true</param>
            <param name="y_log_tick_mirror" type="bool" gui-text="Draw on opposite side">false</param>
          </vbox>
          <spacer />

          <label appearance="header">Tick Labels</label>
          <hbox indent="1">
            <param name="y_log_numtick_visible" type="bool" gui-text="Show">true</param>
          </hbox>
          <spacer />
        </page>
      </param>
      <spacer />

      <label appearance="header">Label</label>
      <param name="y_axis_label" type="string" gui-text="Text:" indent="1">y</param>
      <spacer />

      <label appearance="header">Placement</label>
      <hbox indent="1">
        <param name="y_axis_placement" type="optiongroup" appearance="combo" gui-text="Position:">
          <option value="left">Left</option>
          <option value="right">Right</option>
        </param>
        <spacer />
        <param name="y_axis_pos" type="int" gui-text="Outside offset (px):" min="-9999" max="9999">
          0</param>
      </hbox>
    </page>

    <page name="plot" gui-text="Plot">
      <label appearance="header">Data Reference</label>
      <label indent="1">Specify which columns to use (1-based indexing)</label>
      <hbox indent="1">
        <param name="x_column" type="int" gui-text="X column:" indent="1" min="1" max="999">1</param>
        <spacer />
        <param name="y_column" type="int" gui-text="Y column:" indent="1" min="1" max="999">2</param>
      </hbox>
      <spacer />

      <label appearance="header">Marker</label>
      <vbox indent="1">
        <param name="marker_shape" type="optiongroup" appearance="combo" gui-text="Shape:" indent="1">
          <option value="circle">Circle (○)</option>
          <option value="square">Square (□)</option>
          <option value="diamond">Diamond (◇)</option>
          <option value="triangle">Triangle (△)</option>
          <option value="inverted_triangle">Inverted Triangle (▽)</option>
          <option value="none">(None)</option>
        </param>
        <param name="marker_size" type="float" gui-text="Size (px):" min="0.1" max="99">12.0</param>
        <param name="marker_stroke_width" type="float" gui-text="Stroke width (px):" min="0.1" max="99">1.5</param>
      </vbox>
    </page>

    <page name="layout" gui-text="Title &amp; Frame">
      <label appearance="header">Title</label>
      <vbox indent="1">
        <param name="title_text" type="string" gui-text="Title:"></param>
        <hbox indent="1">
          <param name="title_placement" type="optiongroup" appearance="combo" gui-text="Position:">
            <option value="bottom">Bottom</option>
            <option value="top">Top</option>
          </param>
          <spacer />
          <param name="title_pos" type="int" gui-text="Outside offset (px):" min="-9999" max="9999">84</param>
        </hbox>
      </vbox>
      <spacer />

      <label appearance="header">Frame</label>
      <hbox indent="1">
        <param name="frame_top" type="bool" gui-text="Top" indent="1">true</param>
        <spacer />
        <separator />
        <param name="frame_bottom" type="bool" gui-text="Bottom" indent="1">true</param>
        <spacer />
        <separator />
        <param name="frame_left" type="bool" gui-text="Left" indent="1">true</param>
        <spacer />
        <separator />
        <param name="frame_right" type="bool" gui-text="Right" indent="1">true</param>
      </hbox>
    </page>

    <page name="details" gui-text="Advanced">
      <label appearance="header">Size</label>
      <hbox indent="1">
        <param name="plot_width" type="int" gui-text="Width (px):" min="1" max="99999">400</param>
        <spacer />
        <param name="plot_height" type="int" gui-text="Height (px):" min="1" max="99999">400</param>
      </hbox>
      <spacer />

      <label appearance="header">Font</label>
      <param name="font_family" type="string" gui-text="Font family:" indent="1">sans-serif</param>
      <hbox indent="1">
        <param name="title_font_size" type="int" gui-text="Title (pt):" min="1" max="999">16</param>
        <spacer />
        <param name="axis_label_font_size" type="int" gui-text="Axis label (pt):" min="1" max="999">16</param>
        <spacer />
        <param name="tick_label_font_size" type="int" gui-text="Tick label (pt):" min="1" max="999">14</param>
      </hbox>
      <spacer />

      <label appearance="header">Output Settings</label>
      <param name="group_by_title" type="bool" gui-text="Group by title">false</param>
      <spacer />

      <label appearance="header">Line &amp; Tick Style</label>
      <vbox indent="1">
        <hbox indent="1">
          <param name="frame_stroke_width" type="float" gui-text="Frame stroke width (px):" min="0.1" max="99">
            2.0</param>
          <spacer />
          <param name="tick_stroke_width" type="float" gui-text="Tick line stroke width (px):" min="0.1"
            max="99">
            2.0</param>
        </hbox>
        <spacer size="4" />
        <hbox indent="1">
          <param name="maintick_length" type="float" gui-text="Major tick line length (px):" min="0" max="99">
            12.0</param>
          <spacer />
          <param name="subtick_length" type="float" gui-text="Minor tick line length (px):" min="0" max="99">8.0</param>
        </hbox>
      </vbox>
    </page>
  </param>
  <spacer size="16" />
  <hbox>
    <label>Render items:</label>
    <spacer size="4" />
    <param name="render_x_axis" type="bool" gui-text="X Axis">true</param>
    <spacer />
    <separator />
    <param name="render_y_axis" type="bool" gui-text="Y Axis">true</param>
    <spacer />
    <separator />
    <param name="render_plot" type="bool" gui-text="Plot">true</param>
    <spacer />
    <separator />
    <param name="render_title" type="bool" gui-text="Title">true</param>
    <separator />
    <param name="render_border" type="bool" gui-text="Frame">true</param>
  </hbox>
  <spacer size="4" />
  <param name="page" type="int" gui-text="Page number to render:" min="1" max="99">1</param>

  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Render" />
    </effects-menu>
  </effect>

  <script>
    <command location="inx" interpreter="python">src/main.py</command>
  </script>
</inkscape-extension>
